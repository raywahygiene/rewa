---
import data from '../../src/data/data.json';
const googleScriptUrl = import.meta.env.PUBLIC_GOOGLE_SCRIPT_URL;
data.config.googleScriptUrl = googleScriptUrl;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mobile Dental Care</title>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <style>
        html { scroll-behavior: smooth; }
        
        /* Reveal on Scroll */
        .reveal { opacity: 0; transform: translateY(30px); transition: all 0.8s cubic-bezier(0.5, 0, 0, 1); }
        .reveal.active { opacity: 1; transform: translateY(0); }
        
        /* Background Animations */
        @keyframes float { 0%, 100% { transform: translateY(0px); } 50% { transform: translateY(-20px); } }
        @keyframes gradient { 0% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } 100% { background-position: 0% 50%; } }
        .animate-float { animation: float 6s ease-in-out infinite; }
        .bg-gradient-animate { background-size: 200% 200%; animation: gradient 15s ease infinite; }
        
        .tooth-pattern {
            background-image: radial-gradient(circle at 20px 20px, rgba(59, 130, 246, 0.05) 2px, transparent 0);
            background-size: 40px 40px;
        }

        /* Nav Transition Logic */
        #main-nav { transition: all 0.4s ease-in-out; }

        /* Mobile Menu Smooth Transition */
        #mobile-menu {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            overflow: hidden;
        }
        #mobile-menu.closed {
            max-height: 0;
            opacity: 0;
            pointer-events: none;
        }
        #mobile-menu.open {
            max-height: 100vh;
            opacity: 1;
            pointer-events: auto;
        }
    </style>
</head>
<body class="bg-slate-50 font-sans text-slate-800 antialiased">
    <script define:vars={{ data }}>
        window.APP_DATA = data;
    </script>
    <div id="toast-container" class="fixed top-24 right-5 z-[100] flex flex-col items-end pointer-events-none *:pointer-events-auto"></div>

    <!-- Navigation -->
    <!-- Initial State: Transparent, larger padding (py-4) -->
    <nav id="main-nav" class="fixed w-full top-0 z-50 py-4 bg-transparent border-b border-transparent transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center">
                <!-- Logo -->
                <div class="flex items-center gap-3">
                    <div class="bg-gradient-to-br from-blue-600 to-cyan-500 p-2 rounded-xl shadow-lg">
                        <i class="ri-capsule-fill text-white text-xl"></i>
                    </div>
                    <span class="text-xl font-bold bg-gradient-to-r from-blue-600 to-cyan-500 bg-clip-text text-transparent">Mobile Dental</span>
                </div>

                <!-- Desktop Menu -->
                <div class="flex items-center gap-6">
                    <div class="relative hidden md:block">
                        <i class="ri-global-line absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
                        <select id="lang-selector" class="pl-9 pr-8 py-2 bg-slate-100/80 backdrop-blur-sm rounded-full text-sm font-semibold text-slate-600 outline-none cursor-pointer hover:bg-white transition shadow-sm"></select>
                    </div>

                    <div class="hidden md:flex items-center gap-6">
                        <a href="#home" class="text-sm font-semibold text-slate-600 hover:text-blue-600 transition" data-i18n="nav.home"></a>
                        <a href="#services" class="text-sm font-semibold text-slate-600 hover:text-blue-600 transition" data-i18n="nav.services"></a>
                        <a href="#testimonials" class="text-sm font-semibold text-slate-600 hover:text-blue-600 transition" data-i18n="nav.reviews"></a>
                        <a href="#contact" class="text-sm font-semibold text-slate-600 hover:text-blue-600 transition" data-i18n="nav.contact"></a>
                        <a href="#booking" class="px-6 py-2.5 bg-slate-900 text-white text-sm font-semibold rounded-full hover:bg-blue-600 transition shadow-lg hover:-translate-y-0.5" data-i18n="nav.book"></a>
                    </div>
                    
                    <!-- Mobile Menu Button -->
                    <button id="mobile-menu-btn" class="md:hidden text-2xl text-slate-700 p-2 focus:outline-none">
                        <i class="ri-menu-4-line transition-transform duration-300"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Menu Container (Animated) -->
        <div id="mobile-menu" class="absolute top-full left-0 w-full bg-white/95 backdrop-blur-xl border-t border-slate-100 shadow-xl md:hidden closed">
            <div class="px-4 py-6 space-y-4">
                <a href="#home" class="mobile-link block px-4 py-3 rounded-xl text-slate-600 hover:bg-blue-50 hover:text-blue-600 font-semibold transition" data-i18n="nav.home"></a>
                <a href="#services" class="mobile-link block px-4 py-3 rounded-xl text-slate-600 hover:bg-blue-50 hover:text-blue-600 font-semibold transition" data-i18n="nav.services"></a>
                <a href="#testimonials" class="mobile-link block px-4 py-3 rounded-xl text-slate-600 hover:bg-blue-50 hover:text-blue-600 font-semibold transition" data-i18n="nav.reviews"></a>
                <a href="#contact" class="mobile-link block px-4 py-3 rounded-xl text-slate-600 hover:bg-blue-50 hover:text-blue-600 font-semibold transition" data-i18n="nav.contact"></a>
                
                <div class="px-4 py-2 border-t border-slate-100 mt-4 pt-4">
                    <label class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2 block">Language</label>
                    <select id="mobile-lang-selector" class="w-full p-3 bg-slate-100 rounded-xl text-slate-700 font-semibold outline-none"></select>
                </div>

                <a href="#booking" class="mobile-link block text-center px-4 py-4 bg-slate-900 text-white font-bold rounded-xl shadow-lg mt-4 active:scale-95 transition-transform" data-i18n="nav.book"></a>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section id="home" class="pt-20 relative overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-blue-600 via-cyan-500 to-blue-700 bg-gradient-animate opacity-90"></div>
        <div class="absolute inset-0 tooth-pattern"></div>
        
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-32">
            <div class="grid md:grid-cols-2 gap-12 items-center">
                <div class="text-white reveal active">
                    <div class="inline-block mb-4">
                        <span class="bg-white/20 backdrop-blur-md px-4 py-2 rounded-full text-sm font-semibold border border-white/30" data-i18n="hero.badge"></span>
                    </div>
                    <h1 class="text-5xl md:text-7xl font-bold mb-6 leading-tight">
                        <span data-i18n="hero.title1"></span><br/>
                        <span data-i18n="hero.title2" class="text-cyan-300"></span>
                    </h1>
                    <p data-i18n="hero.desc" class="text-xl md:text-2xl mb-8 text-blue-100 leading-relaxed"></p>
                    <div class="flex flex-col sm:flex-row gap-4">
                        <a href="#booking" class="inline-flex items-center justify-center bg-white text-blue-600 px-8 py-4 rounded-xl font-bold text-lg hover:bg-blue-50 transition shadow-xl hover:shadow-2xl transform hover:scale-105">
                            <i class="ri-calendar-check-line mr-2"></i>
                            <span data-i18n="hero.btn_book"></span>
                        </a>
                    </div>
                    <div class="mt-12 flex items-center space-x-8">
                        <div><p class="text-4xl font-bold">500+</p><p id="stat-label-1" class="text-blue-200"></p></div>
                        <div class="h-12 w-px bg-white/30"></div>
                        <div><p class="text-4xl font-bold">100%</p><p id="stat-label-2" class="text-blue-200"></p></div>
                        <div class="h-12 w-px bg-white/30"></div>
                        <div><p class="text-4xl font-bold">5★</p><p id="stat-label-3" class="text-blue-200"></p></div>
                    </div>
                </div>
                <div class="hidden md:block animate-float">
                    <div class="relative">
                        <div class="absolute inset-0 bg-white/20 backdrop-blur-xl rounded-3xl rotate-6"></div>
                        <div class="relative bg-white/90 backdrop-blur-xl p-8 rounded-3xl shadow-2xl border border-white/50">
                            <h3 data-i18n="hero.why_title" class="text-2xl font-bold text-gray-800 mb-4 text-center"></h3>
                            <div id="features-list" class="space-y-4"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Wave Divider -->
        <div class="relative">
            <svg class="w-full h-24" viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M0,64L80,69.3C160,75,320,85,480,80C640,75,800,53,960,48C1120,43,1280,53,1360,58.7L1440,64L1440,120L1360,120C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120L0,120Z" fill="#f8fafc"/>
            </svg>
        </div>
    </section>

    <!-- Services Section -->
    <section id="services" class="py-24 bg-slate-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-20 reveal">
                <span class="text-blue-600 font-bold tracking-wider text-sm uppercase mb-3 block">Expertise</span>
                <h2 data-i18n="services.title" class="text-4xl md:text-5xl font-bold text-slate-900 mb-6"></h2>
                <p data-i18n="services.subtitle" class="text-xl text-slate-500 max-w-2xl mx-auto"></p>
            </div>
            <div id="services-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-8"></div>
        </div>
    </section>

    <!-- Testimonials Section -->
    <section id="testimonials" class="py-24 bg-white relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-20 reveal">
                <span class="text-blue-600 font-bold tracking-wider text-sm uppercase mb-3 block">Testimonials</span>
                <h2 data-i18n="testimonials.title" class="text-4xl md:text-5xl font-bold text-slate-900 mb-6"></h2>
                <p data-i18n="testimonials.subtitle" class="text-xl text-slate-500 max-w-2xl mx-auto"></p>
            </div>
            <div id="testimonials-grid" class="grid md:grid-cols-3 gap-8"></div>
        </div>
    </section>

    <!-- Booking Section -->
    <section id="booking" class="py-24 bg-slate-50 relative">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16 reveal">
                <h2 data-i18n="booking.title" class="text-4xl md:text-5xl font-bold text-slate-900 mb-6"></h2>
                <p data-i18n="booking.subtitle" class="text-lg text-slate-600"></p>
            </div>
            
            <div class="reveal bg-white rounded-3xl shadow-xl p-8 md:p-12 border border-slate-100">
                <form id="bookingForm" class="space-y-6">
                    <div class="grid md:grid-cols-2 gap-6">
                        <input type="text" name="firstName" required class="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 outline-none transition-all">
                        <input type="text" name="lastName" required class="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 outline-none transition-all">
                    </div>
                    <div class="grid md:grid-cols-2 gap-6">
                        <input type="email" name="email" required class="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 outline-none transition-all">
                        <input type="tel" name="phone" required class="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 outline-none transition-all">
                    </div>
                    <textarea name="message" rows="3" class="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 outline-none transition-all resize-none"></textarea>
                    
                    <button id="submitBtn" type="submit" class="w-full bg-slate-900 text-white py-5 rounded-xl font-bold text-lg shadow-lg hover:bg-blue-600 hover:shadow-blue-500/25 transition-all flex items-center justify-center">
                        <i id="btn-submit-icon" class="ri-send-plane-fill mr-3 text-xl"></i> 
                        <span id="btn-submit-text" data-i18n="booking.btn_submit"></span>
                    </button>
                </form>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer id="contact" class="bg-slate-900 text-slate-300 pt-20 pb-10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid md:grid-cols-4 gap-12 mb-16">
                <div class="col-span-1 md:col-span-2">
                    <div class="flex items-center space-x-3 mb-6">
                        <div class="bg-blue-600 p-1.5 rounded-lg"><i class="ri-capsule-fill text-white text-xl"></i></div>
                        <span class="text-2xl font-bold text-white">Mobile Dental</span>
                    </div>
                    <p data-i18n="footer.about_desc" class="text-slate-400 mb-8 max-w-sm"></p>
                    <div id="footer-socials" class="flex space-x-4"></div>
                </div>
                <div>
                    <h4 data-i18n="footer.links_title" class="text-white font-bold mb-6 text-lg"></h4>
                    <ul class="space-y-4 text-sm font-medium">
                        <li><a href="#home" class="hover:text-blue-400" data-i18n="nav.home"></a></li>
                        <li><a href="#services" class="hover:text-blue-400" data-i18n="nav.services"></a></li>
                        <li><a href="#testimonials" class="hover:text-blue-400" data-i18n="nav.reviews"></a></li>
                    </ul>
                </div>
                <div>
                    <h4 data-i18n="footer.contact_title" class="text-white font-bold mb-6 text-lg"></h4>
                    <ul id="footer-contact-info" class="space-y-4 text-sm text-slate-400"></ul>
                </div>
            </div>
            <div class="border-t border-slate-800 pt-8 text-center md:text-left"><p data-i18n="footer.copyright" class="text-slate-500 text-sm"></p></div>
        </div>
    </footer>

    <script src="../scripts/main.js"></script>
</body>
</html>