<section id="booking" class="py-24 bg-slate-50 relative">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16 reveal" style="transition-delay: 100ms">
            <h2 data-i18n="booking.title" class="text-4xl md:text-5xl font-bold text-slate-900 mb-6"></h2>
            <p data-i18n="booking.subtitle" class="text-lg text-slate-600"></p>
        </div>
        
        <div class="reveal bg-white rounded-3xl shadow-xl p-8 md:p-12 border border-slate-100 transition-shadow hover:shadow-2xl" style="transition-delay: 200ms">
            <form id="bookingForm" class="space-y-6">
                <div class="grid md:grid-cols-2 gap-6">
                    <div class="reveal" style="transition-delay: 300ms">
                        <input type="text" name="firstName" required class="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all placeholder-slate-400">
                        <p class="text-red-500 text-xs mt-1 h-4"></p>
                    </div>
                    <div class="reveal" style="transition-delay: 350ms">
                        <input type="text" name="lastName" required class="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all placeholder-slate-400">
                        <p class="text-red-500 text-xs mt-1 h-4"></p>
                    </div>
                </div>
                <div class="grid md:grid-cols-2 gap-6">
                    <div class="reveal" style="transition-delay: 400ms">
                        <input type="email" name="email" required class="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all placeholder-slate-400">
                        <p class="text-red-500 text-xs mt-1 h-4"></p>
                    </div>
                    <div class="reveal" style="transition-delay: 450ms">
                        <input type="tel" name="phone" required class="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all placeholder-slate-400">
                        <p class="text-red-500 text-xs mt-1 h-4"></p>
                    </div>
                </div>
                <div class="reveal" style="transition-delay: 500ms">
                  <textarea name="message" rows="3" class="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all resize-none placeholder-slate-400"></textarea>
                </div>
                
                <div class="reveal" style="transition-delay: 550ms">
                  <button id="submitBtn" type="submit" class="w-full bg-slate-900 text-white py-5 rounded-xl font-bold text-lg shadow-lg hover:bg-blue-600 hover:shadow-xl hover:shadow-blue-500/30 transition-all flex items-center justify-center transform hover:-translate-y-1 active:scale-95">
                      <i id="btn-submit-icon" class="ri-send-plane-fill mr-3 text-xl"></i> 
                      <span id="btn-submit-text" data-i18n="booking.btn_submit"></span>
                  </button>
                </div>
            </form>
        </div>
    </div>
</section>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.8s cubic-bezier(0.5, 0, 0, 1);
  }
  .reveal.active {
    opacity: 1;
    transform: translateY(0);
  }
</style>